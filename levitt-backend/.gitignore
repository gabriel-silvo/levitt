# Arquivo .gitignore para o projeto Node.js (levitt-backend)

# Dependências
# A pasta node_modules contém todos os pacotes que o npm instala.
# Ela é recriada com 'npm install' e nunca deve ir para o GitHub.
/node_modules

# Arquivos de Ambiente (Segurança)
# Este arquivo contém senhas e chaves de API. É a regra mais importante!
.env

# Logs
# Arquivos de log gerados durante a execução ou em caso de erros.
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
*.seed
*.pid.lock

# Diretórios de build/distribuição
# Caso você compile seu código para produção no futuro.
/dist
/build

# Arquivos de Sistema Operacional
# Lixo gerado pelo macOS, Windows e Linux.
.DS_Store
Thumbs.db
ehthumbs.db

# Arquivos de IDEs e Editores
# Configurações específicas do seu ambiente local.
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?