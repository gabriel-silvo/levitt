# Arquivo .gitignore para o projeto monorepo Levitt

# Dependências de ambos os projetos
levitt-frontend/node_modules
levitt-backend/node_modules

# Arquivo de Ambiente do Backend (Segurança!)
levitt-backend/.env

# Logs e arquivos de runtime do Backend
levitt-backend/logs
levitt-backend/*.log
levitt-backend/npm-debug.log*
levitt-backend/yarn-debug.log*
levitt-backend/yarn-error.log*

# Arquivos de Build/Distribuição
levitt-frontend/dist
levitt-frontend/.vite
levitt-backend/dist
levitt-backend/build

# Arquivos de Sistema Operacional
.DS_Store
Thumbs.db

# Arquivos de IDE
.vscode/